$content = @'
다음 파인스크립트 인디케이터를 JavaScript strategyCode로 변환해줘.

### 출력 형식 (필수)
아래 `function run(candles)` 형식을 반드시 지켜야 해:

```js
function run(candles) {
  // candles = [{ time: Unix초(number), open, high, low, close }, ...]
  // 시간순 오름차순 정렬 보장됨

  const results = [];
  for (let i = 0; i < candles.length; i++) {
    results.push({
      time: candles[i].time,
      close: candles[i].close,
      long: false,   // BUY 조건 (boolean)
      short: false,  // SELL 조건 (boolean)
    });
  }

  // 박스/레벨 라인이 있으면 lines도 반환 (없으면 생략 가능)
  // lines.b1/b2/b3 = [{ time, top, mid, btm }, ...]
  // 색상: b1=Yellow(#FFD700), b2=Lime(#32CD32), b3=Red(#FF4444)
  return {
    signals: results,
    lines: {
      b1: [],  // [{ time, top, mid, btm }, ...]
      b2: [],
      b3: [],
    },
  };
}
```

### PineScript → JS 변환 규칙

| PineScript | JavaScript 등가 코드 |
|---|---|
| `ta.highest(high, n)` | `Math.max(...candles.slice(Math.max(0,i-n+1),i+1).map(c=>c.high))` |
| `ta.lowest(low, n)` | `Math.min(...candles.slice(Math.max(0,i-n+1),i+1).map(c=>c.low))` |
| `ta.crossover(a, b)` | `prev_a <= prev_b && cur_a > cur_b` |
| `ta.crossunder(a, b)` | `prev_a >= prev_b && cur_a < cur_b` |
| `ta.barssince(cond)` | 아래 헬퍼 함수 구현 |
| `ta.valuewhen(cond, src, n)` | 아래 헬퍼 함수 구현 |
| `ta.sma(src, n)` | `slice(i-n+1,i+1).reduce((s,c)=>s+c.close,0)/n` |
| `request.security(...)` | 무시하거나 같은 candles 배열 사용 (멀티 TF 불가) |
| `[_top, _btm] = request.security(...)` | 해당 TF 하드코딩된 len 값만 추출해서 단일 TF로 계산 |

### `ta.barssince` / `ta.valuewhen` 헬퍼

```js
function barssince(condArr, i) {
  for (let j = i - 1; j >= 0; j--) {
    if (condArr[j]) return i - j;
  }
  return i + 1;
}

function valuewhen(condArr, srcArr, i, n) {
  let count = 0;
  for (let j = i; j >= 0; j--) {
    if (condArr[j]) {
      if (count === n) return srcArr[j];
      count++;
    }
  }
  return srcArr[0] ?? 0;
}
```

### `request.security` 처리 규칙
- 이 코드는 단일 TF candles 배열만 받음
- `request.security(id, "5S", f(20))`, `request.security(id, "1", f(28))`, `request.security(id, "5", f(89))` 같은 멀티 TF 호출은 하드코딩된 len 값(20, 28, 89)만 따로 변수로 추출해서 같은 candles에 각각 적용
- 즉 box1=len20, box2=len28, box3=len89 로 3번 연산하되 모두 동일 candles 사용

### 반환값 조건
- **홍보용 지표는 모든 신호를 독립적으로 표시** — 교대(BUY→SELL→BUY) 방식이 아닌 `plotshape`처럼 동작
- 아래 형식으로 `markers`를 직접 만들어 반환할 것 (권장):

```js
const markers = [];
for (const r of results) {
  if (r.long)  markers.push({ time: r.time, position: "belowBar", color: "#00ff00", shape: "arrowUp",   text: "▲", size: 1 });
  if (r.short) markers.push({ time: r.time, position: "aboveBar", color: "#ff4444", shape: "arrowDown", text: "▼", size: 1 });
}
return { markers, trades: [], lines: { b1: [], b2: [], b3: [] } };
```

- 박스 라인이 없는 전략은 `lines` 생략 또는 빈 배열로 반환
- 외부 라이브러리 사용 금지, 순수 JS만 사용
- 코드 전체가 `function run(candles) { ... }` 하나로 완결될 것

### 보조지표 헬퍼 구현 (필요 시 run 내부에 정의)

```js
// ta.sma(src, n)
function sma(arr, i, n) {
  const s = Math.max(0, i - n + 1);
  let sum = 0;
  for (let j = s; j <= i; j++) sum += arr[j];
  return sum / (i - s + 1);
}

// ta.ema(src, n) — 첫 n봉은 SMA 시드, n번째 봉부터 EMA 적용
function calcEma(arr, n) {
  const out = new Array(arr.length).fill(0);
  const k = 2 / (n + 1);
  let sum = 0;
  for (let i = 0; i < arr.length; i++) {
    if (i < n - 1) {
      sum += arr[i];
      out[i] = (sum + arr[i]) / (i + 1); // 미완성 구간 (참조용)
    } else if (i === n - 1) {
      sum += arr[i];
      out[i] = sum / n; // SMA 시드
    } else {
      out[i] = arr[i] * k + out[i - 1] * (1 - k);
    }
  }
  return out;
}

// ta.rma(src, n) — Wilder 이동평균 (alpha = 1/n, SMA 시드)
function calcRma(arr, n) {
  const out = new Array(arr.length).fill(0);
  const alpha = 1 / n;
  let sum = 0;
  for (let i = 0; i < arr.length; i++) {
    if (i < n - 1) {
      sum += arr[i];
      out[i] = sum / (i + 1); // 미완성 구간
    } else if (i === n - 1) {
      sum += arr[i];
      out[i] = sum / n; // SMA 시드
    } else {
      out[i] = alpha * arr[i] + (1 - alpha) * out[i - 1]; // Wilder EWM
    }
  }
  return out;
}

// ta.rsi(src, n)
function calcRsi(closes, n) {
  const gains = [0], losses = [0];
  for (let i = 1; i < closes.length; i++) {
    const d = closes[i] - closes[i - 1];
    gains.push(d > 0 ? d : 0);
    losses.push(d < 0 ? -d : 0);
  }
  const avgGain = calcRma(gains, n);
  const avgLoss = calcRma(losses, n);
  return avgGain.map((g, i) => avgLoss[i] === 0 ? 100 : 100 - 100 / (1 + g / avgLoss[i]));
}

// ta.atr(n)
function calcAtr(candles, n) {
  const tr = candles.map((c, i) => {
    if (i === 0) return c.high - c.low;
    const prev = candles[i - 1];
    return Math.max(c.high - c.low, Math.abs(c.high - prev.close), Math.abs(c.low - prev.close));
  });
  return calcRma(tr, n);
}

// ta.bb(src, n, mult) → { upper, basis, lower }
function calcBb(arr, n, mult) {
  return arr.map((_, i) => {
    const s = Math.max(0, i - n + 1);
    const slice = arr.slice(s, i + 1);
    const mean = slice.reduce((a, b) => a + b, 0) / slice.length;
    const std = Math.sqrt(slice.reduce((a, b) => a + (b - mean) ** 2, 0) / slice.length);
    return { upper: mean + std * mult, basis: mean, lower: mean - std * mult };
  });
}

// ta.macd(src, fast, slow, signal) → { macd, signal, hist }
function calcMacd(arr, fast, slow, sigLen) {
  const emaFast = calcEma(arr, fast);
  const emaSlow = calcEma(arr, slow);
  const macdLine = emaFast.map((v, i) => v - emaSlow[i]);
  const sigLine = calcEma(macdLine, sigLen);
  return macdLine.map((v, i) => ({ macd: v, signal: sigLine[i], hist: v - sigLine[i] }));
}

// ta.stoch(close, high, low, n) → %K 배열
function calcStoch(closes, highs, lows, n) {
  return closes.map((_, i) => {
    const s = Math.max(0, i - n + 1);
    const hh = Math.max(...highs.slice(s, i + 1));
    const ll = Math.min(...lows.slice(s, i + 1));
    return hh === ll ? 50 : ((closes[i] - ll) / (hh - ll)) * 100;
  });
}

// nz(x, replacement=0) — na 값을 0(또는 지정값)으로 치환
function nz(x, y = 0) { return (x == null || isNaN(x)) ? y : x; }
```

### 보조지표 사용 시 주의사항
- 지표 배열을 미리 전체 계산한 후 (`calcRsi(closes, 14)` 등) 루프에서 인덱스로 참조
- `ta.rma`를 `ta.sma`로 대체하지 말 것 (RSI 값이 달라짐)
- `ta.ema` 초기값은 반드시 SMA 시드 사용
- PineScript `na` → JS `null` 또는 `NaN`, `nz()` 헬퍼로 처리

